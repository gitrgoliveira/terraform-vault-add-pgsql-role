apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: ${workload_name}-${usecase_name}-auth
  namespace: <K8S_NAMESPACE>
spec:
  method: jwt
  mount: ${jwt_auth_path}
  namespace: <VAULT_NAMESPACE>
  jwt:
    role: ${auth_role_name}
    serviceAccount: <K8S_SERVICE_ACCOUNT>
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultDynamicSecret
metadata:
  name: ${workload_name}-${usecase_name}
  namespace: <K8S_NAMESPACE>
spec:
  vaultAuthRef: ${workload_name}-${usecase_name}-auth
  mount: ${db_mount_path}
  path: static-creds/${db_role_name}
  destination:
    create: true
    name: ${workload_name}-${usecase_name}
  refreshAfter: 30s
